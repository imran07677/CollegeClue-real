# College Clue Environment Configuration Example
SECRET_KEY=django-insecure-cc-super-secret-key-change-me-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database settings (defaults to SQLite if DB_ENGINE is empty or sqlite3)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
